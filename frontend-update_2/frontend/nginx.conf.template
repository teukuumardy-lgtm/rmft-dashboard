server {
    # The PORT env var is substituted into this line at container startup by
    # the official nginx image's built-in envsubst-on-templates entrypoint
    # (any file under /etc/nginx/templates/*.template is rendered into
    # /etc/nginx/conf.d/ before nginx starts). Defaults to 80 via the
    # Dockerfile's ENV PORT=80, which matches docker-compose's "8080:80"
    # mapping; hosts that inject their own PORT (e.g. Render) are picked up
    # automatically with no code change.
    listen ${PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # SPA fallback
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Proxy API calls to the backend container (see docker-compose.yml)
    location /api/ {
        proxy_pass http://backend:8000/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /manifest.webmanifest {
        add_header Cache-Control "no-cache";
    }
}
